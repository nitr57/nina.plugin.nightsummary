<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NINA.Plugin.NightSummary</AssemblyName>
    <RootNamespace>NINA.Plugin.NightSummary</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationIcon>NINAPluginTemplate.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.xaml.cs;**/*.xaml</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
    <ProjectReference Include="..\..\..\NINA.Plugin\NINA.Plugin.csproj" />
    <ProjectReference Include="..\..\..\System.Windows.Compat\System.Windows.Compat.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="*" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MyPluginProperties\AssemblyInfo.cs" />
    <Compile Remove="Server\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="MyPluginDockables\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\plugin-icon.png">
      <LogicalName>plugin-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Reporting\metric-chart.js">
      <LogicalName>metric-chart.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\demo-nightsummary.sqlite">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MyPluginProperties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="MyPluginProperties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="PostBuildLinux" AfterTargets="PostBuildEvent">
    <Exec Command="mkdir -p $HOME/.local/share/NINA/Plugins/3.0.0/NightSummary" />
    <Exec Command="cp $(TargetPath) $HOME/.local/share/NINA/Plugins/3.0.0/NightSummary/" />
  </Target>
</Project>
